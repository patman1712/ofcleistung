# .npmrc - OFC Leistungsdiagnostik
# WICHTIG fuer Railway / Produktion / npm 10+:
# - allow-scripts = true  => Alle install scripts erlauben (better-sqlite3, esbuild, prisma engines)
#       NPM_CONFIG_ALLOW_SCRIPTS=1 per ENV ist seit npm 10 PRO VERBOTEN (Error EALLOWSCRIPTS).
#       Nur per package.json allowScripts ODER .npmrc erlaubt!
# - omit = (LEER) => Keine devDependencies weglassen. Ist zwar default in prod,
#       aber wir haben Build-Tools (prisma, tsc) in dependencies + wollen sicher sein.
allow-scripts=true
omit=
fund=false
audit=false
loglevel=error
