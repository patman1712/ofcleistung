{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "buildCommand": "",
    "watchPatterns": [
      "/src/**",
      "/client/src/**",
      "/client/index.html",
      "/prisma/**",
      "/package.json",
      "/client/package.json",
      "/Dockerfile",
      "/tailwind.config.js"
    ]
  },
  "deploy": {
    "startCommand": "",
    "healthcheckPath": "/api/auth/me",
    "healthcheckTimeout": 500,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "volumes": [
      {
        "name": "ofc-sqlite-data",
        "mountPath": "/app/data"
      }
    ],
    "tcpProxyProtocol": null
  }
}
