{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/api/auth/me",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "startCommand": "",
    "volumes": [
      {
        "name": "ofc-sqlite-data",
        "mountPath": "/app/data"
      }
    ]
  }
}
