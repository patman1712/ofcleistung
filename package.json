{
  "name": "ofc-leistungsdiagnostik",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "mkdir -p data && tsx watch src/server.ts",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "build": "mkdir -p data && npm run build:client && tsc -p tsconfig.json",
    "prestart": "mkdir -p data",
    "start": "node dist/server.js",
    "migrate": "mkdir -p data && prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "mkdir -p data && tsx prisma/seed.ts",
    "prisma:push": "mkdir -p data && prisma db push",
    "start:prod": "mkdir -p data && npm run prisma:push && npm run seed || true && node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
