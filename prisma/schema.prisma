// Prisma Schema - OFC Leistungsdiagnostik (SQLite)
// ACHTUNG: SQLite unterstuetzt KEINE Enums in Prisma! Role/QuestionType sind als
// String modelliert und werden per Applikation validiert (Zod + TS-Typen).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./data/ofc.db"
}

// --------------------------------------------------------------
// Value-Range (wie Enums, aber String, siehe TypeScript Types):
//   Role         -> "ADMIN" | "PLAYER"
//   QuestionType -> "RATING_1_10" | "TEXT"
//   AlertScope   -> "DAILY" | "TRAINING" | "ALL"
//   AlertSeverity-> "WARNING" | "CRITICAL"
// --------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("PLAYER") // "ADMIN" | "PLAYER"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  playerProfile PlayerProfile?

  dailyAnswers        DailyAnswer[]
  dailyAnswerSessions DailyAnswerSession[]
  trainingAnswers     TrainingAnswer[]
  createdTrainings    Training[]
}

model PlayerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate   DateTime?
  heightCm    Int?
  weightKg    Float?
  position    String?
  phoneNumber String? // Für WhatsApp Reminder (E.164 Format, z.B. +4915112345678)

  trainingsAsPlayer TrainingPlayer[]
  alerts            Alert[]
}

model DailyQuestion {
  id           String   @id @default(cuid())
  text         String
  questionType String   @default("RATING_1_10") // "RATING_1_10" | "RATING" | "TEXT"
  minRating    Int      @default(1)
  maxRating    Int      @default(10)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  repeatTime   String?  @default("06:00")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  answers DailyAnswer[]
}

model DailyAnswerSession {
  id          String   @id @default(cuid())
  playerId    String
  player      User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  date        DateTime
  completedAt DateTime?
  remarks     String?  // 🆕 Allgemeine Bemerkung / Notiz des Spielers pro Tag (sauber gespeichert, nicht an Textfrage gehängt!)
  createdAt   DateTime @default(now())

  answers DailyAnswer[]

  @@unique([playerId, date])
  @@index([playerId, date])
}

model DailyAnswer {
  id         String             @id @default(cuid())
  sessionId  String
  session    DailyAnswerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId   String
  player     User               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionId String
  question   DailyQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rating     Int?
  text       String?
  createdAt  DateTime @default(now())

  triggeredAlert Alert? // 🆕 Wenn diese einzelne Antwort einen Alert ausgelöst hat

  @@index([sessionId])
  @@index([playerId])
  @@index([questionId])
}

model Training {
  id          String   @id @default(cuid())
  title       String
  scheduledAt DateTime
  durationMin Int?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  players   TrainingPlayer[]
  questions TrainingQuestion[]
}

model TrainingPlayer {
  id              String   @id @default(cuid())
  trainingId      String
  training        Training      @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  remarks         String?  // 🆕 Allgemeine Bemerkung / Notiz des Spielers für dieses Training

  answers TrainingAnswer[]

  @@unique([trainingId, playerProfileId])
  @@index([trainingId])
  @@index([playerProfileId])
}

model TrainingQuestion {
  id           String   @id @default(cuid())
  trainingId   String
  training     Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  text         String
  questionType String   @default("RATING_1_10") // "RATING_1_10" | "RATING" | "TEXT"
  minRating    Int      @default(1)
  maxRating    Int      @default(10)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  answers TrainingAnswer[]

  @@index([trainingId])
}

model TrainingAnswer {
  id               String   @id @default(cuid())
  trainingPlayerId String
  trainingPlayer   TrainingPlayer @relation(fields: [trainingPlayerId], references: [id], onDelete: Cascade)
  questionId       String
  question         TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  playerId         String
  player           User     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  rating           Int?
  text             String?
  createdAt        DateTime @default(now())

  triggeredAlert Alert? // 🆕 Wenn diese einzelne Antwort einen Alert ausgelöst hat

  @@index([trainingPlayerId])
  @@index([playerId])
  @@index([questionId])
}

model AlertConfig {
  id               String   @id @default(cuid())
  name             String
  scope            String   @default("ALL") // "DAILY" | "TRAINING" | "ALL"
  threshold        Int      @default(3)
  consecutiveCount Int      @default(2)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  alerts Alert[]
}

model Alert {
  id              String   @id @default(cuid())
  configId        String
  config          AlertConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  message         String
  severity        String   @default("WARNING") // "WARNING" | "CRITICAL"
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  // 🆕 NEU: Alert wird AUSGELÖST von einer einzelnen Antwort!
  dailyAnswerId    String?       @unique
  dailyAnswer      DailyAnswer?  @relation(fields: [dailyAnswerId], references: [id], onDelete: Cascade)
  trainingAnswerId String?       @unique
  trainingAnswer   TrainingAnswer? @relation(fields: [trainingAnswerId], references: [id], onDelete: Cascade)

  // 🆕 NEU: Scope unterscheiden (damit Dashboard gut anzeigen kann)
  answerScope      String? // "DAILY_SINGLE" | "TRAINING_SINGLE" | "STREAK" (ALT)
  ratingValue      Int?    // Bewertung die den Alert auslöste (z.B. 3)
  thresholdUsed    Int?    // Schwellwert der verwendet wurde (z.B. 5 oder minRating)
  questionSnapshot String? // Frage-Text zum Zeitpunkt des Alerts (für Nachvollziehbarkeit, falls Frage später gelöscht/geändert)

  @@index([playerProfileId])
  @@index([resolved])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON oder Base64 oder Plaintext
  updatedAt DateTime @updatedAt
}
